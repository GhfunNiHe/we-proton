diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0000000..0000000 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -76,10 +76,64 @@
-    if(NOT EXISTS "${ONNXRUNTIME_DIR}")
-        if(NOT EXISTS "download/${ONNXRUNTIME_FILENAME}")
             # Download onnxruntime release
-            message("Downloading ${ONNXRUNTIME_URL}")
-            file(DOWNLOAD "${ONNXRUNTIME_URL}" "download/${ONNXRUNTIME_FILENAME}")
-        endif()
-
-        # Extract .zip or .tgz to a directory like lib/onnxruntime-linux-x64-1.14.1/
-        file(ARCHIVE_EXTRACT INPUT "download/${ONNXRUNTIME_FILENAME}" DESTINATION "${CMAKE_CURRENT_LIST_DIR}/lib")
-    endif()
+    set(ONNXRUNTIME_ARCHIVE "${CMAKE_CURRENT_BINARY_DIR}/download/${ONNXRUNTIME_FILENAME}")
+    set(ONNXRUNTIME_HEADER "${ONNXRUNTIME_DIR}/include/onnxruntime_cxx_api.h")
+
+    # A previous interrupted extraction can leave the directory behind without headers.
+    if(EXISTS "${ONNXRUNTIME_DIR}" AND NOT EXISTS "${ONNXRUNTIME_HEADER}")
+        file(REMOVE_RECURSE "${ONNXRUNTIME_DIR}")
+    endif()
+
+    if(NOT EXISTS "${ONNXRUNTIME_DIR}")
+        file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/download")
+        set(ONNXRUNTIME_ARCHIVE_VALID FALSE)
+
+        # Reuse only a complete gzip archive; CMake's DOWNLOAD can otherwise leave
+        # a truncated file that makes the later compiler error misleading.
+        if(EXISTS "${ONNXRUNTIME_ARCHIVE}")
+            execute_process(
+                COMMAND tar -tzf "${ONNXRUNTIME_ARCHIVE}"
+                RESULT_VARIABLE ONNXRUNTIME_ARCHIVE_STATUS
+                OUTPUT_QUIET
+                ERROR_QUIET
+            )
+            if(ONNXRUNTIME_ARCHIVE_STATUS EQUAL 0)
+                set(ONNXRUNTIME_ARCHIVE_VALID TRUE)
+            else()
+                file(REMOVE "${ONNXRUNTIME_ARCHIVE}")
+            endif()
+        endif()
+
+        if(NOT ONNXRUNTIME_ARCHIVE_VALID)
+            message("Downloading ${ONNXRUNTIME_URL}")
+            foreach(ONNXRUNTIME_ATTEMPT RANGE 1 5)
+                file(REMOVE "${ONNXRUNTIME_ARCHIVE}")
+                file(DOWNLOAD "${ONNXRUNTIME_URL}" "${ONNXRUNTIME_ARCHIVE}"
+                    STATUS ONNXRUNTIME_DOWNLOAD_STATUS
+                    TIMEOUT 180
++                )
+                list(GET ONNXRUNTIME_DOWNLOAD_STATUS 0 ONNXRUNTIME_DOWNLOAD_CODE)
+                if(ONNXRUNTIME_DOWNLOAD_CODE EQUAL 0)
+                    execute_process(
+                        COMMAND tar -tzf "${ONNXRUNTIME_ARCHIVE}"
+                        RESULT_VARIABLE ONNXRUNTIME_ARCHIVE_STATUS
+                        OUTPUT_QUIET
+                        ERROR_QUIET
+                    )
+                    if(ONNXRUNTIME_ARCHIVE_STATUS EQUAL 0)
+                        set(ONNXRUNTIME_ARCHIVE_VALID TRUE)
+                        break()
+                    endif()
+                endif()
+                file(REMOVE "${ONNXRUNTIME_ARCHIVE}")
+                message(WARNING "ONNX Runtime download attempt ${ONNXRUNTIME_ATTEMPT}/5 failed (${ONNXRUNTIME_DOWNLOAD_STATUS}); retrying")
+            endforeach()
+        endif()
+
+        if(NOT ONNXRUNTIME_ARCHIVE_VALID)
+            message(FATAL_ERROR "Could not download a valid ONNX Runtime archive after 5 attempts")
+        endif()
+
+        file(ARCHIVE_EXTRACT INPUT "${ONNXRUNTIME_ARCHIVE}" DESTINATION "${CMAKE_CURRENT_LIST_DIR}/lib")
+        if(NOT EXISTS "${ONNXRUNTIME_HEADER}")
+            message(FATAL_ERROR "ONNX Runtime archive did not contain ${ONNXRUNTIME_HEADER}")
+        endif()
+    endif()
